---
import {
  DEFAULT_LOCALE,
  LOCALE_HREFLANG,
  LOCALE_HTML_LANG,
  LOCALE_LABELS,
  LOCALES,
  isLocale,
  localeHomePath,
  type Locale,
} from "../i18n/locales";
import { DOCS_URL, FORION_URL } from "../site";
import Logo from "./Logo.astro";

type Props = {
  locale?: Locale;
  languagesLabel?: string;
  navLabel?: string;
  homeHref?: string;
  homeLabel?: string;
  linkLabels?: Record<string, string>;
};

const currentLocale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : (Astro.props.locale ?? DEFAULT_LOCALE);
const {
  languagesLabel = "Language",
  navLabel = "Footer",
  homeHref = localeHomePath(currentLocale),
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrentPage(href: string): boolean {
  return (href.replace(/\/+$/, "") || "/") === currentPath;
}

type FooterLink = { href: string; label: string };

const columns: Array<{ heading: string; links: FooterLink[] }> = [
  {
    heading: "Product",
    links: [
      { href: "/download/", label: "Download" },
      { href: DOCS_URL, label: "Docs" },
      { href: "/pricing/", label: "Pricing" },
      { href: "/blog/", label: "Blog" },
    ],
  },
  {
    heading: "Company",
    links: [
      { href: "/about/", label: "About" },
      { href: "/brand/", label: "Brand" },
      { href: "/support/", label: "Support" },
      { href: "/privacy/", label: "Privacy" },
      { href: "/terms/", label: "Terms" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="site-footer__brand">
    <Logo href={homeHref} label="Orbit home" />
    <nav class="site-footer__languages" aria-label={languagesLabel}>
      <details class="language-menu">
        <summary>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
          {LOCALE_LABELS[currentLocale]}
          <svg class="language-menu__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
        </summary>
        <ul>
          {
            LOCALES.map((locale) => (
              <li>
                <a
                  href={localeHomePath(locale)}
                  hreflang={LOCALE_HREFLANG[locale]}
                  lang={LOCALE_HTML_LANG[locale]}
                  aria-current={locale === currentLocale ? "true" : undefined}
                >
                  {LOCALE_LABELS[locale]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
    <span class="site-footer__legal">
      <span>© 2026 <a href={FORION_URL} target="_blank" rel="noopener">Forion</a></span>
      <span>Orbit Bot</span>
    </span>
  </div>
  <nav class="site-footer__columns" aria-label={navLabel}>
    {
      columns.map((column) => (
        <div class="site-footer__column">
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href} aria-current={isCurrentPage(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</footer>
