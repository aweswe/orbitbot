{
  "name": "@forion/orbit-worker",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-watch.mjs src/index.ts",
    "build": "node ../../scripts/build-server.mjs src/index.ts src/health-check.ts",
    "start": "node --enable-source-maps dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. apps/worker/src"
  },
  "dependencies": {
    "@forion/orbit-adapter-kit": "workspace:*",
    "@forion/orbit-adapters": "workspace:*",
    "@forion/orbit-core": "workspace:*",
    "@forion/orbit-db": "workspace:*",
    "@forion/orbit-logging": "workspace:*",
    "@forion/orbit-memory": "workspace:*"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
