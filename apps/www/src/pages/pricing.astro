---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Button from "../components/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL, DOCS_URL } from "../site";
---

<BaseLayout
  title="Pricing · Orbit"
  description="Orbit Bot plans and credits are managed in the app."
>
  <div class="container">
    <Header />
    <main id="main" class="pricing">
      <h1 class="section-heading">Pricing</h1>
      <div class="section-intro">
        <p class="section-copy">
          Orbit Bot plans, model credits, and computer hours are shown in the app, where they are tied to
          your Forion account. Open Orbit to see the current plan and usage for your workspace.
        </p>
        <div class="hero__actions">
          <Button href={APP_URL}>Open Orbit</Button>
          <Button href={DOCS_URL} variant="secondary" external>Read the docs</Button>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
