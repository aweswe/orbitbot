---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { DOCS_URL, GITHUB_URL } from "../site";
---

<BaseLayout title="Support · Orbit" description="Get help with the Orbit app and self-hosted deployments.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>Orbit support</h1>
      <p>
        For help with Orbit, email{" "}
        <a href="mailto:hello@forion.dev">hello@forion.dev</a>. Include the email address on your
        account, what you expected to happen, and any error message you saw. Do not send passwords, API keys,
        access tokens, or other secrets.
      </p>
      <h2>Self-hosted Orbit</h2>
      <p>
        Start with the <a href={DOCS_URL}>documentation</a>. For reproducible bugs or feature requests,
        open an issue in the <a href={`${GITHUB_URL}/issues`}>GitHub repository</a>.
      </p>
      <h2 id="account-deletion">Account deletion</h2>
      <p>
        In the mobile app, open <strong>Account</strong>, enter your current password under{" "}
        <strong>Delete account</strong>, and confirm. On the web, sign in at{" "}
        <a href="https://orbit.forion.dev">orbit.forion.dev</a> and do the same under{" "}
        <strong>Settings</strong> → <strong>Account</strong>. This permanently deletes the hosted account and its
        associated personal Space data.
      </p>
      <p>
        Without access to the app, email <a href="mailto:hello@forion.dev">hello@forion.dev</a> from your account's
        email address to ask us to delete it. Sign-in security records are kept for up to 90 days.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
