---
import {
  DEFAULT_LOCALE,
  isLocale,
  type Locale,
} from "../i18n/locales";
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL, DOCS_URL } from "../site";
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

const locale: Locale = isLocale(Astro.currentLocale)
  ? Astro.currentLocale
  : DEFAULT_LOCALE;

const title = "Orbit Bot | Autonomous agents with their own computers";
const description =
  "Orbit Bot gives every agent a persistent computer, real tools, and a place on your team. Run it on web, desktop, and mobile.";

const features = [
  {
    title: "Persistent computers",
    body: "Each bot gets a Linux computer with a browser, shell, files, and a desktop it can keep.",
  },
  {
    title: "Real tools",
    body: "Read and write files, run commands, browse the web, and connect MCP tools.",
  },
  {
    title: "Multi-agent teams",
    body: "Group chats, handoffs, and subagents let bots divide work and stay in sync.",
  },
  {
    title: "Routines and triggers",
    body: "Scheduled tasks and webhooks start work without waiting for a prompt.",
  },
  {
    title: "Approvals you control",
    body: "Pause before consequential actions. Approve once, approve always, or take over.",
  },
  {
    title: "Anywhere you work",
    body: "Use Orbit on the web, in the desktop app, or on your phone.",
  },
] as const;

const steps = [
  { title: "Create a bot", body: "Give it a name, a job, and the tools it needs." },
  { title: "Give it a computer", body: "The bot keeps its files, browser, and workspace between tasks." },
  { title: "Review the work", body: "Watch progress, answer approvals, and step in when you want." },
] as const;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  index={locale === DEFAULT_LOCALE}
  canonicalPath={locale === DEFAULT_LOCALE ? undefined : "/"}
  ogImageAlt="Orbit Bot — autonomous agents with their own computers."
>
  <div class="container">
    <Header />
    <main id="main">
      <section class="hero">
        <img src="/brand/orbit-mark.png" width="72" height="72" alt="" class="hero__mark" style="display:block;margin:0 auto 24px;object-fit:contain" />
        <div class="eyebrow">Orbit by Forion</div>
        <h1>Autonomous agents with their own computers</h1>
        <p class="lead">{description}</p>
        <div class="hero__actions">
          <Button href={APP_URL}>Open Orbit</Button>
          <Button href={DOCS_URL} variant="secondary" external>Read the docs</Button>
        </div>
      </section>

      <section class="section" aria-labelledby="capabilities-heading">
        <div class="section-intro">
          <h2 id="capabilities-heading" class="section-heading">What Orbit does</h2>
          <p class="section-copy">
            The harness gives an agent a durable place to work, the tools to finish the job, and
            a human in the loop when it matters.
          </p>
        </div>
        <div class="card-grid-3">
          {
            features.map((feature) => (
              <article class="feature-card">
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="how-heading">
        <div class="section-intro">
          <h2 id="how-heading" class="section-heading">How it works</h2>
        </div>
        <div class="card-grid-3">
          {
            steps.map((step, index) => (
              <article class="feature-card">
                <div class="eyebrow">0{index + 1}</div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section platforms" aria-labelledby="platforms-heading">
        <div class="section-intro">
          <h2 id="platforms-heading" class="section-heading">Where you can use it</h2>
          <div class="platforms__cards">
            <article class="platform-card">
              <h3>Web</h3>
              <div class="platform-card__links">
                <a href={APP_URL}>Open Orbit</a>
              </div>
            </article>
            <article class="platform-card">
              <h3>Desktop</h3>
              <div class="platform-card__links">
                <a href="/download/">Download Orbit</a>
              </div>
            </article>
            <article class="platform-card">
              <h3>Mobile</h3>
              <div class="platform-card__links">
                <a href="/download/">Download Orbit</a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="stats-band">
        <div>
          <h2>Give your next task to an Orbit bot.</h2>
          <p>Start in the web app, then carry the same workspace with you.</p>
          <div class="cta-actions">
            <Button href={APP_URL}>Open Orbit</Button>
            <Button href={DOCS_URL} variant="secondary" external>Read the docs</Button>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
