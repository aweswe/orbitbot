---
import { ANDROID_APP_STORE_URL } from "@forion/orbit-contracts/client-build";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  availableDesktopPlatforms,
  desktopDownloadHref,
  fetchDesktopDownloads,
} from "../github";
import BaseLayout from "../layouts/BaseLayout.astro";
import { APP_URL, DOCS_URL, IOS_APP_URL } from "../site";

const downloads = await fetchDesktopDownloads();

const DESKTOP_NAMES = { mac: "macOS", windows: "Windows", linux: "Linux" } as const;
const platforms = [
  ...availableDesktopPlatforms(downloads).map((platform) => ({
    name: DESKTOP_NAMES[platform],
    action: "Download",
    href: desktopDownloadHref(platform),
    attr: platform,
  })),
  { name: "iPhone", action: "App Store", href: IOS_APP_URL, attr: "ios" },
  { name: "Android", action: "Google Play", href: ANDROID_APP_STORE_URL, attr: "android" },
  { name: "Web", action: "Open", href: APP_URL, attr: "web" },
];
---

<BaseLayout title="Download · Orbit" description="Get Orbit for macOS, Windows, Linux, iPhone, Android, and the web.">
  <div class="container">
    <Header />
    <main id="main" class="privacy-copy">
      <h1>Download Orbit</h1>
      <ul class="platform-list">
        {
          platforms.map((platform) => (
            <li>
              <span>{platform.name}</span>
              <a
                class="button button--secondary button--small"
                href={platform.href}
                aria-label={`${platform.action}: ${platform.name}`}
                data-attr={`download-page-${platform.attr}`}
              >
                {platform.action}
              </a>
            </li>
          ))
        }
      </ul>
      <p>
        The desktop and mobile apps connect to the same Orbit workspace as the web app. See the{" "}
        <a href={DOCS_URL}>documentation</a> for setup and deployment details.
      </p>
    </main>
    <Footer />
  </div>
</BaseLayout>
