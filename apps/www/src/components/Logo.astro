---
type Props = {
  href?: string;
  label?: string;
};

const { href = "/", label = "Orbit home" } = Astro.props as Props;
---

<a class="brand-lockup" href={href} aria-label={label}>
  <img
    class="brand-lockup__mark"
    src="/brand/orbit-mark.png"
    width="36"
    height="36"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__word">orbit</span>
</a>
